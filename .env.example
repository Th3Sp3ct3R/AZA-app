# Targets HTTP MCP — used by AzA / the harness to collect leads (zero account burn).
# Real values go in .env (gitignored). Endpoint + bearer token are provider-supplied.
TARGETS_MCP_ENDPOINT=
TARGETS_MCP_TOKEN=

# Browserbase — hosted Chrome with persistent Contexts, for consistent/persistent
# profile scraping + enrichment (the @ares/connectors Browserbase adapter, P1).
# Get key + project id at https://www.browserbase.com/sign-up → Settings → API Keys.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
# Optional BYO proxy (http://user:pass@host:port). For IG use, point at the
# geo-matched mobile proxy — Browserbase's built-in pool won't clear IG checkpoints.
BROWSERBASE_PROXY=
